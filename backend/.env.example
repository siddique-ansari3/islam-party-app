# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=islam_party
DB_USER=postgres
DB_PASSWORD=change_me

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# AES-256-GCM key for encrypting Aadhaar numbers at rest (must be exactly 32 bytes, hex-encoded = 64 chars)
AADHAAR_ENCRYPTION_KEY=replace_with_64_hex_characters_generated_via_crypto_randomBytes_32

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# MSG91 (SMS + WhatsApp Business API) - https://msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_SMS_TEMPLATE_ID=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=

# Initial super admin (used only by db:seed script)
SEED_SUPER_ADMIN_EMAIL=admin@islamparty.local
SEED_SUPER_ADMIN_PASSWORD=change_me_immediately
SEED_SUPER_ADMIN_NAME=Super Admin
